@page
@{ViewData["Title"]="Colour, in your own way.";ViewData["Page"]="home";}
<section class="fashion-hero"><div class="fashion-hero-copy"><span class="eyebrow">FOULARD & FASHION · MAARAKE</span><h1>A colour story.<br/><em>A finishing touch.</em></h1><p>Follow a beautiful print or a favourite palette. Explore scarf styling and fashion inspiration, and find a new direction for your everyday edit.</p><a href="/shop" class="button">Explore the collection <span></span></a><div class="hero-meta"><span>EXPLORE THE COLLECTION</span><span>A PERSONAL CONVERSATION</span></div></div><div class="fashion-hero-image hero-collage"><img src="@Shop.Settings.Hero" alt="From the Yasmina Foulard collection" width="640" height="850" fetchpriority="high"/><img src="@Shop.Products.Where(p=>p.Images[0]!=Shop.Settings.Hero).First().Images[0]" alt="Another look from Yasmina Foulard" width="640" height="850"/><img src="@Shop.Products.Where(p=>p.Images[0]!=Shop.Settings.Hero).Skip(1).First().Images[0]" alt="More inspiration from Yasmina Foulard" width="640" height="850"/><span class="photo-label">THE YASMINA EDIT</span></div><span class="hero-decoration" aria-hidden="true">✳</span></section>
<div class="values-strip"><span>Colour, in your own way.</span><i>✦</i><span>Discover · Save · Enquire</span><i>✦</i><a href="/lookbook">A closer look at the collection </a></div>
<div class="n12-running" aria-hidden="true"><div><span>Yasmina Foulard</span><i>✦</i><span>FOULARD & FASHION · MAARAKE</span><i>✦</i><span>Discover · Save · Enquire</span><i>✦</i><span>Made for your own point of view</span><i>✦</i><span>Yasmina Foulard</span><i>✦</i><span>FOULARD & FASHION · MAARAKE</span><i>✦</i><span>Discover · Save · Enquire</span><i>✦</i><span>Made for your own point of view</span><i>✦</i><span>Yasmina Foulard</span><i>✦</i><span>FOULARD & FASHION · MAARAKE</span><i>✦</i><span>Discover · Save · Enquire</span><i>✦</i><span>Made for your own point of view</span><i>✦</i><span>Yasmina Foulard</span><i>✦</i><span>FOULARD & FASHION · MAARAKE</span><i>✦</i><span>Discover · Save · Enquire</span><i>✦</i><span>Made for your own point of view</span><i>✦</i></div></div>
<section class="section first-edit" data-reveal><div class="section-heading"><div><span class="eyebrow">FIND YOUR NEXT FAVOURITE</span><h2>Good looks.<br/><em>Your own way.</em></h2></div><div><p>A selection from the collection.<br/>Keep the looks you love close.</p><a href="/shop" class="text-link">Discover the whole edit </a></div></div><div class="product-grid">@foreach(var p in Shop.Products.Take(4)){<partial name="_Card" model="p"/>}</div></section>
<section class="fashion-story" data-reveal><div class="fashion-story-photo"><img src="@Shop.Settings.Story" alt="A closer look at Yasmina Foulard" width="900" height="1200" loading="lazy"/></div><div class="fashion-story-copy"><span class="eyebrow">THE WORLD OF YASMINA</span><h2>A closer look.<br/><em>A personal connection.</em></h2><p>Yasmina Foulard brings together printed scarves and Turkish fashion in Maarake, South Lebanon. Discover the photographed scarf stories, explore modest styling and send a personal enquiry to the boutique.</p><a href="/our-world" class="button outline">Discover our world <span></span></a></div></section>
<section class="section category-edit" data-reveal><div class="section-heading"><div><span class="eyebrow">A LITTLE DIRECTION</span><h2>What are you<br/><em>in the mood for?</em></h2></div><a href="/style-guide" class="text-link">Help me choose </a></div><div class="category-grid">@foreach(var (category,i) in Shop.Products.Select(p=>p.Collection).Distinct().Take(3).Select((x,i)=>(x,i))){var p=Shop.Products.First(p=>p.Collection==category);<a href="/shop?collection=@Uri.EscapeDataString(category)"><div><img src="@p.Images[0]" alt="@category from Yasmina Foulard" width="700" height="930" loading="lazy"/></div><span>@category <b></b></span></a>}</div></section>
<section class="section diary-feature" data-reveal><div><span class="eyebrow">THE VISUAL DIARY</span><h2>A detail.<br/>A different angle.<br/><em>A new favourite.</em></h2><p>Explore the collection in photographs. Follow a colour, discover a silhouette and gather your inspiration.</p><a href="/lookbook" class="button">Open the photo diary <span></span></a></div><div class="diary-pair"><img src="@Shop.Products.Last().Images[0]" alt="Collection inspiration from Yasmina Foulard" width="720" height="960" loading="lazy"/><img src="@Shop.Products.Skip(1).First().Images.Last()" alt="More collection details from Yasmina Foulard" width="520" height="690" loading="lazy"/></div></section>
<section class="section shopping-steps" data-reveal><div><span class="eyebrow">MAKE IT PERSONAL</span><h2>From inspiration<br/><em>to a conversation.</em></h2></div><ol><li><h3>Find your favourites</h3><p>Browse the collection, explore the photographs and save the looks that speak to you.</p></li><li><h3>Build your selection</h3><p>Add your pieces to a bag and share your size, colour and delivery questions.</p></li><li><h3>Talk to the team</h3><p>Review your enquiry before sending. The boutique confirms options, availability and the final price.</p></li></ol></section>
